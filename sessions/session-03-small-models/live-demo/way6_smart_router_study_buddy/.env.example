# Copy to .env and fill in the block for the environment you're demoing.

# --- APP_ENV controls which model_routing.yaml entry is active ---
# dev | staging | prod
# (defaults to `default_env` in model_routing.yaml if unset)
APP_ENV=dev

# --- AI Studio key, needed whenever the frontier tutor can be reached: dev's
#     escalation, or the staging/prod default. Quickest to set up, but AI
#     Studio keys can get API-restricted (403 API_KEY_SERVICE_BLOCKED) --
#     Vertex AI below is the more reliable path for a live demo. ---
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=False

# --- Vertex AI instead (recommended) ---
GOOGLE_CLOUD_PROJECT=your-project-id
# `global` is required, not a default of convenience: regional endpoints
# don't serve gemini-3 preview models, only global does.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
#
# Needs Application Default Credentials for the account with access to that
# project, not just `gcloud auth login`:
#   gcloud auth application-default login --account you@example.com
#   gcloud auth application-default set-quota-project your-project-id
#   gcloud services enable aiplatform.googleapis.com --project=your-project-id
# ADC is a single machine-wide file, switching accounts here affects every
# local tool that reads it, not just this demo.
