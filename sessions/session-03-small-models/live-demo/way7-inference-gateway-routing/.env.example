# Copy to .env before starting the gateway.

# Way 1/2's local Ollama (native or the Docker container from Way 2, same port)
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Way 3's Ollama Cloud, sign in first with `ollama signin` (see ../03-ollama-cloud-opencode.md)
OLLAMA_CLOUD_API_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=

# Gemini via AI Studio, quickest for a demo
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=

# Turn on the routing.yaml in this folder
ROUTING_ENABLED=true
ROUTING_CONFIG_PATH=./routing.yaml
