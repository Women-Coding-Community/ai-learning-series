# Copy to .env. Use ONE of the two blocks.

# Option 1: Vertex AI (uses your gcloud login, no API key)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
# `global` serves the newest Gemini models; use a region such as europe-west2 if your org requires it.
GOOGLE_CLOUD_LOCATION=global
# One-off setup:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project your-project-id
#   gcloud services enable aiplatform.googleapis.com --project=your-project-id

# Option 2: Gemini API key from AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=False
# GOOGLE_API_KEY=

# Optional: model for every agent (default gemini-2.5-flash)
# DEMO_MODEL=gemini-2.5-flash
